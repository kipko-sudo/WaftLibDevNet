<odoo>
    <!-- List view -->
    <record id="view_todo_tree" model="ir.ui.view">
        <field name="name">todo.task.tree</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="is_done"/>
                <field name="priority"/>
                <field name="due_date"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_todo_form" model="ir.ui.view">
        <field name="name">todo.task.form</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_done"/>
                        <field name="active"/>
                        <field name="priority"/>
                        <field name="due_date"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action FIRST -->
    <record id="action_todo_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menus AFTER action -->
    <menuitem id="menu_todo_root" name="To-Do"/>
    <menuitem id="menu_todo_task" name="Tasks" parent="menu_todo_root" action="action_todo_task"/>
    <menuitem id="menu_todo_root" name="To-Do" action="action_todo_task"/>
</odoo>