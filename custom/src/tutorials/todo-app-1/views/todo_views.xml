<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree view -->
    <record id="view_todo_tree" model="ir.ui.view">
        <field name="name">todo.task.tree</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <tree decoration-danger="priority == '2'" decoration-warning="priority == '1'" decoration-muted="priority == '0'">
                <field name="name"/>
                <field name="stage"/>
                <field name="is_done"/>
                <field name="priority"/>
                <field name="due_date"/>
                <field name="is_overdue"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_todo_form" model="ir.ui.view">
        <field name="name">todo.task.form</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="stage"/>
                        <field name="is_done"/>
                        <field name="priority"/>
                        <field name="due_date"/>
                        <field name="deadline"/>
                        <field name="is_overdue" readonly="1"/>
                        <field name="user_id"/>
                    </group>
                    <notebook>
                        <page string="Subtasks">
                            <field name="subtask_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="is_done"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban view -->
    <record id="view_todo_kanban" model="ir.ui.view">
        <field name="name">todo.task.kanban</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="total_subtask_count"/>
                <field name="done_subtask_count"/>
                <field name="name"/>
                <field name="stage"/>
                <field name="priority"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_color_#{record.priority.raw_value}">
                            <strong><field name="name"/></strong>
                            <div>Stage: <field name="stage"/></div>
                            <div>Assigned: <field name="user_id"/></div>
                            <!-- <div>
                                <t t-esc="len(record.subtask_ids.raw_value)"/> Subtasks
                                (<t t-esc="len([s for s in record.subtask_ids.raw_value if s['is_done']])"/> Done)
                            </div> -->
                            <div>
                                <t t-esc="record.total_subtask_count.raw_value"/> Subtasks
                                (<t t-esc="record.done_subtask_count.raw_value"/> Done)
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Kanban Visual -->
    <record id="view_todo_task_kanban" model="ir.ui.view">
        <field name="name">todo.task.kanban</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="priority" class="o_kanban_example">
                <field name="name"/>
                <field name="priority"/>
                <field name="deadline"/>
                <field name="is_done"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div>
                                <span>Priority: <field name="priority"/></span>
                            </div>
                            <div>
                                <span>Deadline: <field name="deadline"/></span>
                            </div>
                            <div>
                                <span>Status: 
                                    <t t-if="record.is_done.raw_value">✅ Done</t>
                                    <t t-else="">🕒 Pending</t>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_todo_task_graph" model="ir.ui.view">
        <field name="name">todo.task.graph</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <graph string="Tasks Analysis" type="bar">
                <field name="is_done" type="row"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>


    <!-- Search view -->
    <record id="view_todo_task_search" model="ir.ui.view">
        <field name="name">todo.task.search</field>
        <field name="model">todo.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="stage"/>
                <field name="priority"/>
                <field name="user_id"/>
                <filter string="My Tasks" name="filter_my_tasks" domain="[('user_id','=',uid)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_todo_task" model="ir.actions.act_window">
        <field name="name">To-Do Tasks Kanban</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_todo_task_search"/>
    </record>

    <!-- Kanban Action -->
    <record id="action_todo_task_kanban" model="ir.actions.act_window">
        <field name="name">To-Do Tasks (Kanban)</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p>
                Use this view to organize tasks visually with deadlines and priorities.
            </p>
        </field>
    </record>

    <!-- Graph Action -->
    <record id="action_todo_task_graph" model="ir.actions.act_window">
        <field name="name">Tasks Analysis</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">graph,tree,form</field>
    </record>


    <!-- Menus -->
    <menuitem id="menu_todo_root" name="To-Do"/>
    <menuitem id="menu_todo_task" name="Tasks" parent="menu_todo_root" action="action_todo_task"/>
    <menuitem id="menu_todo_task_kanban" name="Tasks (Kanban)" parent="menu_todo_root" action="action_todo_task_kanban"/>
    <menuitem id="menu_todo_task_graph" name="Tasks (Graph)" parent="menu_todo_root" action="action_todo_task_graph"/>

</odoo>